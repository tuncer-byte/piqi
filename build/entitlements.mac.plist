<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime izinleri. Hem Piqi.app'e hem paketteki yardımcılara (Electron Helper'lar, piqi-audio, piqi-tts)
  uygulanır. Konuşma tanıma ve sistem sesi yakalama entitlement gerektirmez; izin metinleri Info.plist'tedir.
-->
<plist version="1.0">
<dict>
	<!-- Electron/V8 JavaScript motoru çalışma anında kod üretir. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Mikrofon: "Selam Piqi" ve kullanıcının kendi konuşması (piqi-audio). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
